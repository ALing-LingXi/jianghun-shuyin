    expect(
      jobSchema.parse({
        id: jobId,
        bookId,
        status: "queued",
        stage: "decoding",
        progress: 0,
        errorMessage: null,
        createdAt,
        updatedAt: createdAt,
      }),
    ).toMatchObject({ id: jobId, status: "queued" });
