<file path="src/server/infrastructure/db/repositories.ts">
import { randomUUID } from "node:crypto";
import { eq } from "drizzle-orm";
import type { Book, Job } from "@/server/domain/entities";
import type {
  BookRepository,
  CreateBookInput,
  CreateJobInput,
  JobRepository,
} from "@/server/ports/repositories";
import type { BookStatus, JobStage, JobStatus } from "@/shared/types/entities";
import type { AppDatabase } from "./client";
import { books, jobs } from "./schema";

type BookRow = typeof books.$inferSelect;
type JobRow = typeof jobs.$inferSelect;

export class DrizzleBookRepository implements BookRepository {
  constructor(private readonly db: AppDatabase) {}

  async create(input: CreateBookInput): Promise<Book> {
    const book: Book = {
      id: randomUUID(),
      title: input.title,
      author: input.author ?? null,
      sourcePath: input.sourcePath,
      status: input.status ?? "pending",
      createdAt: new Date(),
    };

    this.db.insert(books).values(book).run();
    return book;
  }

  async findById(id: string): Promise<Book | null> {
    const row = this.db.select().from(books).where(eq(books.id, id)).get();
    return row ? toBook(row) : null;
  }
}

export class DrizzleJobRepository implements JobRepository {
  constructor(private readonly db: AppDatabase) {}

  async create(input: CreateJobInput): Promise<Job> {
    const now = new Date();
    const job: Job = {
      id: randomUUID(),
      bookId: input.bookId,
      status: input.status ?? "queued",
      stage: input.stage ?? "decoding",
      progress: input.progress ?? 0,
      errorMessage: input.errorMessage ?? null,
      createdAt: now,
      updatedAt: now,
    };

    this.db.insert(jobs).values(job).run();
    return job;
  }

  async findById(id: string): Promise<Job | null> {
    const row = this.db.select().from(jobs).where(eq(jobs.id, id)).get();
    return row ? toJob(row) : null;
  }
}

function toBook(row: BookRow): Book {
  return {
    ...row,
    status: row.status as BookStatus,
  };
}

function toJob(row: JobRow): Job {
  return {
    ...row,
    status: row.status as JobStatus,
    stage: row.stage as JobStage,
  };
}
</file>

<file path="src/server/infrastructure/db/schema.ts">
import { integer, sqliteTable, text } from "drizzle-orm/sqlite-core";

export const books = sqliteTable("books", {
  id: text("id").primaryKey(),
  title: text("title").notNull(),
  author: text("author"),
  sourcePath: text("source_path").notNull(),
  status: text("status").notNull(),
  createdAt: integer("created_at", { mode: "timestamp_ms" }).notNull(),
});

export const jobs = sqliteTable("jobs", {
  id: text("id").primaryKey(),
  bookId: text("book_id")
    .notNull()
    .references(() => books.id),
  status: text("status").notNull(),
  stage: text("stage").notNull(),
  progress: integer("progress").notNull(),
  errorMessage: text("error_message"),
  createdAt: integer("created_at", { mode: "timestamp_ms" }).notNull(),
  updatedAt: integer("updated_at", { mode: "timestamp_ms" }).notNull(),
});

export const parts = sqliteTable("parts", {
  id: text("id").primaryKey(),
  bookId: text("book_id")
    .notNull()
    .references(() => books.id),
  index: integer("part_index").notNull(),
  title: text("title").notNull(),
  audioPath: text("audio_path"),
  durationSeconds: integer("duration_seconds"),
  status: text("status").notNull(),
});

export const chunks = sqliteTable("chunks", {
  id: text("id").primaryKey(),
  partId: text("part_id")
    .notNull()
    .references(() => parts.id),
  index: integer("chunk_index").notNull(),
  textHash: text("text_hash").notNull(),
  audioPath: text("audio_path"),
  status: text("status").notNull(),
  retryCount: integer("retry_count").notNull(),
  errorMessage: text("error_message"),
});
</file>

